# Do not commit .env. Start by copying this file to .env only after you have
# created a Face Recognition Service in the local CompreFace UI.
COMPREFACE_API_KEY=

# Optional: values below use their documented defaults when omitted.
# LOOKOUT_PORT=3000
# LOOKOUT_BIND_ADDRESS=0.0.0.0
# COMPREFACE_PORT=8000
# COMPREFACE_BIND_ADDRESS=127.0.0.1
# COMPREFACE_POSTGRES_USER=postgres
# COMPREFACE_POSTGRES_PASSWORD=replace-with-a-strong-local-password
# COMPREFACE_POSTGRES_DB=frs

# Local (non-Docker) `npm run dev` only. Docker Compose always routes Lookout
# to the local compreface-ui service unless LOOKOUT_COMPREFACE_URL is set.
# COMPREFACE_URL=http://localhost:8000
# LOOKOUT_COMPREFACE_URL=http://compreface-ui

# Required when exposing the shared WebSocket beyond localhost. Use a long,
# random secret and set VITE_SYNC_TOKEN to the same value for portal clients.
# LOOKOUT_SYNC_TOKEN=replace-with-a-long-random-sync-secret
# VITE_SYNC_TOKEN=replace-with-the-same-client-sync-secret
